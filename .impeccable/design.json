      "css": ".ds-card{display:flex;align-items:center;gap:14px;max-width:300px;padding:14px 16px 14px 14px;border-radius:20px;background:var(--color-paper);box-shadow:var(--shadow-lift);font-family:var(--font-body);} .ds-date{display:flex;flex-direction:column;align-items:center;justify-content:center;width:52px;height:56px;border-radius:14px;background:var(--color-accent);color:var(--color-ink);} .ds-date span{font-size:12px;font-weight:700;} .ds-date b{font-size:24px;font-weight:800;line-height:1;} .ds-card-text{display:flex;flex-direction:column;gap:2px;} .ds-card-status{font-size:12px;font-weight:700;color:var(--color-accent-ink);} .ds-card-text strong{font-size:15px;color:var(--color-ink);} .ds-card-sub{font-size:13px;color:var(--color-graphite);}"
