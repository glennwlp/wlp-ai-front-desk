{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wlp-ai-front-desk",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
  // Bindings set at deploy time, not in the repo: secret_text TURNSTILE_SECRET, NOTION_TOKEN, FORM_SECRET, APPS_SCRIPT_URL; plain_text NOTION_DATABASE_ID.
  // Public Turnstile sitekey is a build-time env var: PUBLIC_TURNSTILE_SITEKEY.
}
