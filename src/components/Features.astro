---
import Bubble from './Bubble.astro';
import SectionHeader from './SectionHeader.astro';
const files = ['price-list.pdf', 'faq.docx', 'cancellation-policy.pdf', 'opening-hours.txt'];
const inbox = [
  ['Jordan P.', 'Can I bring my own beard oil?', 'Needs Sam', 'bg-warning-wash text-warning'],
  ['Priya K.', 'Haircut + beard, Sat 9:30', 'Booked', 'bg-accent-wash text-accent-ink'],
  ['Tom W.', 'Do you take card?', 'Answered', 'bg-wash text-graphite'],
];
const row = 'grid gap-6 border-b border-rule py-9 lg:grid-cols-[minmax(0,600px)_minmax(0,440px)] lg:justify-between lg:gap-10';
const annot = 'order-first flex max-w-[440px] flex-col gap-[10px] lg:order-none';
const cap = 'text-[20px] font-semibold leading-[1.3] tracking-[-0.2px] text-ink';
const desc = 'max-w-[420px] text-[16px] leading-[1.6] text-graphite';
---
<section id="features" class="bg-white">
  <div class="wrap flex flex-col gap-10 py-16 md:gap-14 lg:py-[120px]">
    <SectionHeader title="One conversation, start to finish">Booking is one thing it does. Follow a single customer from first question to follow-up, and see what the assistant handles at each step.</SectionHeader>

    <div class="border-t border-ink">
      <!-- Trained on your business -->
      <div class={row}>
        <div class="flex flex-col gap-[10px]">
          <p class="text-[13px] font-semibold leading-[1.4] text-graphite">Knowledge</p>
          <ul class="flex flex-wrap gap-2">
            {files.map((f) => (
              <li class="flex items-center gap-2 rounded-control border border-border-strong bg-white px-3 py-2 text-[14px] font-medium leading-[1.3] text-ink">
                <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>{f}
              </li>
            ))}
          </ul>
          <p class="text-[13px] leading-[1.4] text-faint">4 documents, trained 2 minutes ago</p>
        </div>
        <div class={annot}><h3 class={cap + ' !font-body'}>Trained on your business</h3><p class={desc}>Upload your price list, FAQs, and policies. It answers from what you’ve given it and nothing else.</p></div>
      </div>

      <!-- Answers questions end to end -->
      <div class={row}>
        <div class="flex flex-col gap-[10px]">
          <Bubble role="customer">How much is a haircut? And do you do beards?</Bubble>
          <Bubble role="assistant">A haircut is $38. A beard trim is $22, or $55 if you book both together.</Bubble>
        </div>
        <div class={annot}><h3 class={cap + ' !font-body'}>Answers questions end to end</h3><p class={desc}>Prices, hours, parking, policies. Customers get the full answer straight away, not “someone will get back to you.”</p></div>
      </div>

      <!-- Books appointments -->
      <div class={row}>
        <div class="flex flex-col gap-[10px]">
          <Bubble role="customer">Can I get both on Saturday morning?</Bubble>
          <Bubble role="assistant">Sam has 9:30 or 11:00 on Saturday. Which works?</Bubble>
          <Bubble role="customer" class="min-w-[182px]">9:30</Bubble>
          <Bubble role="assistant">Done. Haircut and beard trim with Sam, Saturday at 9:30.</Bubble>
        </div>
        <div class={annot}><h3 class={cap + ' !font-body'}>Books appointments</h3><p class={desc}>The same assistant checks your calendar and books the slot without leaving the chat.</p></div>
      </div>

      <!-- Sends reminders -->
      <div class={row}>
        <div class="flex flex-col gap-[10px]">
          <p class="text-[13px] font-medium leading-[1.4] text-faint">Friday, 6:00 PM</p>
          <Bubble role="assistant">Reminder: you’re with Sam tomorrow at 9:30. Reply C to confirm or R to reschedule.</Bubble>
          <Bubble role="customer" class="min-w-[182px]">C</Bubble>
        </div>
        <div class={annot}><h3 class={cap + ' !font-body'}>Sends reminders</h3><p class={desc}>A reminder goes out the day before. Customers confirm or reschedule by replying.</p></div>
      </div>

      <!-- Hands off to a human -->
      <div class={row}>
        <div class="flex flex-col gap-[10px]">
          <Bubble role="customer">Can I bring my own beard oil? I’m allergic to some.</Bubble>
          <Bubble role="assistant">That’s a question for Sam. I’ve sent this chat over, and the team usually replies within the hour.</Bubble>
        </div>
        <div class={annot}><h3 class={cap + ' !font-body'}>Hands off to a human</h3><p class={desc}>When a question needs a person, it says so and passes the whole conversation to your team.</p></div>
      </div>

      <!-- Dashboard -->
      <div class={row + ' !border-b-0'}>
        <div>
          <div class="overflow-hidden rounded-[10px] border border-border-table bg-white" role="table" aria-label="Sample inbox">
            {inbox.map(([name, msg, status, tone], i) => (
              <div role="row" class:list={['flex items-center gap-4 px-4 py-[14px]', i > 0 && 'border-t border-rule']}>
                <span role="cell" class="w-[90px] shrink-0 text-[14px] font-semibold leading-[1.3] text-ink">{name}</span>
                <span role="cell" class="min-w-0 flex-1 text-[14px] leading-[1.3] text-graphite max-sm:basis-0">{msg}</span>
                <span role="cell" class={`shrink-0 rounded-chip px-2 py-[3px] text-[12px] font-semibold leading-[1.3] ${tone}`}>{status}</span>
              </div>
            ))}
          </div>
        </div>
        <div class={annot}><h3 class={cap + ' !font-body'}>Simple dashboard, starting on your website</h3><p class={desc}>Every conversation, booking, and handoff lands in one inbox. The widget starts on your website, with Messenger, WhatsApp, and Instagram after that.</p></div>
      </div>
      <div class="border-t border-ink"></div>
    </div>
  </div>
</section>
