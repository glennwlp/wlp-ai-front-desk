---
import Logo from './Logo.astro';
const links = [['Features', '#features'], ['How it works', '#how-it-works'], ['Pricing', '#pricing'], ['FAQ', '#faq'], ['Privacy', '#'], ['Terms', '#'], ['Contact', '#contact']];
---
<footer class="border-t border-rule bg-white">
  <div class="wrap flex flex-col gap-6 py-10 lg:flex-row lg:items-center lg:justify-between">
    <Logo size="footer" />
    <nav aria-label="Footer" class="flex flex-wrap gap-x-1 gap-y-1 lg:justify-center">
      {links.map(([l, h]) => <a href={h} class="rounded-full px-3 py-2 text-[15px] font-semibold text-graphite transition-colors hover:bg-stage hover:text-ink" data-demo={h === '#' ? '' : undefined}>{l}</a>)}
    </nav>
    <p class="text-[14px] text-faint">© 2026 WhitelabelPRESS</p>
  </div>
</footer>
<script>
  // Privacy and Terms have no destination yet: keep them inert.
  document.querySelectorAll('a[data-demo]').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
</script>
