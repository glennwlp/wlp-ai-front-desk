---
import Logo from './Logo.astro';
const links = [['Features', '#features'], ['How it works', '#how-it-works'], ['Pricing', '#pricing'], ['FAQ', '#faq'], ['Privacy', '#'], ['Terms', '#'], ['Contact', 'mailto:hello@whitelabelpress.com']];
---
<footer class="on-dark bg-ink">
  <div class="wrap flex flex-col gap-8 pb-12 pt-16">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <Logo tone="dark" size="footer" />
      <nav aria-label="Footer" class="flex flex-wrap gap-x-8 gap-y-3">
        {links.map(([l, h]) => <a href={h} class="text-[14px] leading-[1.4] text-on-dark-muted hover:text-white" data-demo={h === '#' ? '' : undefined}>{l}</a>)}
      </nav>
    </div>
    <p class="text-[13px] leading-[1.4] text-on-dark-faint">© 2026 WhitelabelPRESS</p>
  </div>
</footer>
<script>
  // Privacy and Terms have no destination yet: keep them inert.
  document.querySelectorAll('a[data-demo]').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
</script>
