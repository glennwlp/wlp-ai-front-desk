---
// Public Turnstile sitekey, injected at build time: PUBLIC_TURNSTILE_SITEKEY=0x4AAAA... npm run build
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const next = ['We email you when your spot opens.', 'A short call to set it up on your website.', 'You keep your launch price.'];
---
<section id="early-access" class="on-teal bg-accent">
  <div class="wrap py-16 lg:py-32">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_460px] lg:gap-16">
      <div class="flex max-w-[700px] flex-col gap-5">
        <h2 class="font-display text-[clamp(44px,6.11vw,88px)] font-bold leading-[0.95] tracking-[-2px] text-white">Let it answer the next message.</h2>
        <p class="max-w-[520px] text-[18px] leading-[1.55] text-on-accent-muted">Join early access. We’ll help you set it up on your website and you keep your launch price.</p>
      </div>
      <div class="flex flex-col gap-5 rounded-panel bg-white p-6 sm:p-9">
        <h3 class="font-display text-[clamp(34px,3.2vw,46px)] font-bold leading-[1.02] tracking-[-0.8px] text-ink">Save your spot</h3>
        <form id="early-form" class="flex flex-col gap-[10px]" novalidate data-sitekey={sitekey}>
          <label for="email" class="text-[15px] font-semibold leading-[1.3] text-ink">Email address</label>
          <input id="email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@yourbusiness.com" aria-describedby="early-hint early-ok early-err" class="h-12 w-full rounded-control border border-border-strong bg-white px-4 text-[16px] leading-[1.3] text-ink placeholder:text-faint focus-visible:border-accent" />
          <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
            <label for="company_url">Leave this field empty</label>
            <input id="company_url" name="company_url" type="text" tabindex="-1" autocomplete="off" />
          </div>
          {sitekey && <div id="early-turnstile" class="min-h-[65px]"></div>}
          <button id="early-submit" type="submit" class="btn btn-primary w-full disabled:cursor-wait disabled:opacity-70">Get early access</button>
          <p id="early-err" class="hidden px-0 py-1 text-[14px] font-semibold leading-[1.4] text-danger" role="alert"></p>
          <p id="early-ok" class="hidden rounded-control bg-accent-wash px-3 py-2 text-[14px] font-semibold leading-[1.4] text-accent-ink" role="status"></p>
        </form>
        <p id="early-hint" class="text-[13px] leading-[1.4] text-faint">We’ll only email you about early access.</p>
        <div>
          <p class="text-[15px] font-semibold leading-[1.3] text-ink">What happens next</p>
          <ol class="mt-[1px]">
            {next.map((t, i) => (
              <li class="mt-[0px] flex items-center gap-[14px] border-t border-rule py-3 first:mt-3">
                <span class="w-4 shrink-0 font-display text-[20px] font-bold leading-none text-accent">{i + 1}</span>
                <span class="text-[15px] leading-[1.45] text-ink">{t}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>
{sitekey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
<script>
  const form = document.getElementById('early-form') as HTMLFormElement;
  const email = document.getElementById('email') as HTMLInputElement;
  const honey = document.getElementById('company_url') as HTMLInputElement;
  const btn = document.getElementById('early-submit') as HTMLButtonElement;
  const okMsg = document.getElementById('early-ok')!;
  const errMsg = document.getElementById('early-err')!;
  const sitekey = form.dataset.sitekey || '';
  const label = btn.textContent || 'Get early access';
  let widgetId: string | undefined;
  let token = '';

  // Turnstile (managed mode, explicit render). The script loads async, so wait for it.
  if (sitekey) {
    let tries = 0;
    const t = setInterval(() => {
      const ts = (window as any).turnstile;
      if (ts) {
        clearInterval(t);
        widgetId = ts.render('#early-turnstile', {
          sitekey, theme: 'light', size: 'flexible',
          callback: (v: string) => { token = v; },
          'expired-callback': () => { token = ''; },
          'error-callback': () => { token = ''; },
        });
      } else if (++tries > 100) clearInterval(t);
    }, 100);
  }

  const resetWidget = () => { token = ''; if (widgetId !== undefined) (window as any).turnstile?.reset(widgetId); };
  const showError = (msg: string, invalid = false) => {
    okMsg.classList.add('hidden');
    errMsg.textContent = msg;
    errMsg.classList.remove('hidden');
    email.setAttribute('aria-invalid', String(invalid));
    email.classList.toggle('!border-danger', invalid);
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (btn.disabled) return;
    const value = email.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value) || value.length > 254) {
      showError('Enter a valid email address, like you@yourbusiness.com.', true);
      email.focus();
      return;
    }
    if (!sitekey) return showError('Sign-up is not available right now. Please try again later.');
    if (!token) return showError('Please complete the security check, then press the button again.');

    btn.disabled = true;
    btn.setAttribute('aria-busy', 'true');
    btn.textContent = 'Sending…';
    errMsg.classList.add('hidden');
    okMsg.classList.add('hidden');
    email.setAttribute('aria-invalid', 'false');
    email.classList.remove('!border-danger');
    try {
      const res = await fetch('/api/signup', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          email: value,
          company_url: honey.value,
          'cf-turnstile-response': token,
          notes: (location.pathname + location.search).slice(0, 300),
        }),
      });
      const out = await res.json().catch(() => null);
      if (res.ok && out && out.ok) {
        okMsg.textContent = 'You’re on the list. We’ll email you when your spot opens.';
        okMsg.classList.remove('hidden');
        form.reset();
      } else {
        showError((out && out.error) || 'Something went wrong. Please try again.', !!(out && out.field === 'email'));
      }
    } catch {
      showError('Could not reach the server. Check your connection and try again.');
    } finally {
      resetWidget(); // tokens are single-use
      btn.disabled = false;
      btn.removeAttribute('aria-busy');
      btn.textContent = label;
    }
  });
</script>
