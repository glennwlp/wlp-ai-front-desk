---
const next = ['We email you when your spot opens.', 'A short call to set it up on your website.', 'You keep your launch price.'];
---
<section id="early-access" class="on-teal bg-accent">
  <div class="wrap py-16 lg:py-32">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_460px] lg:gap-16">
      <div class="flex max-w-[700px] flex-col gap-5">
        <h2 class="font-display text-[clamp(44px,6.11vw,88px)] font-bold leading-[0.95] tracking-[-2px] text-white">Let it answer the next message.</h2>
        <p class="max-w-[520px] text-[18px] leading-[1.55] text-on-accent-muted">Join early access. We’ll help you set it up on your website and you keep your launch price.</p>
      </div>
      <div class="flex flex-col gap-5 rounded-panel bg-white p-6 sm:p-9">
        <h3 class="font-display text-[clamp(34px,3.2vw,46px)] font-bold leading-[1.02] tracking-[-0.8px] text-ink">Save your spot</h3>
        <form id="early-form" class="flex flex-col gap-[10px]" novalidate>
          <label for="email" class="text-[15px] font-semibold leading-[1.3] text-ink">Email address</label>
          <input id="email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@yourbusiness.com" aria-describedby="early-hint early-ok early-err" class="h-12 w-full rounded-control border border-border-strong bg-white px-4 text-[16px] leading-[1.3] text-ink placeholder:text-faint focus-visible:border-accent" />
          <button type="submit" class="btn btn-primary w-full">Get early access</button>
          <p id="early-err" class="hidden px-0 py-1 text-[14px] font-semibold leading-[1.4] text-danger" role="alert"></p>
          <p id="early-ok" class="hidden rounded-control bg-accent-wash px-3 py-2 text-[14px] font-semibold leading-[1.4] text-accent-ink" role="status"></p>
        </form>
        <p id="early-hint" class="text-[13px] leading-[1.4] text-faint">We’ll only email you about early access.</p>
        <div>
          <p class="text-[15px] font-semibold leading-[1.3] text-ink">What happens next</p>
          <ol class="mt-[1px]">
            {next.map((t, i) => (
              <li class="mt-[0px] flex items-center gap-[14px] border-t border-rule py-3 first:mt-3">
                <span class="w-4 shrink-0 font-display text-[20px] font-bold leading-none text-accent">{i + 1}</span>
                <span class="text-[15px] leading-[1.45] text-ink">{t}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  // Demo only: nothing is sent anywhere.
  const form = document.getElementById('early-form') as HTMLFormElement;
  const email = document.getElementById('email') as HTMLInputElement;
  const okMsg = document.getElementById('early-ok')!;
  const errMsg = document.getElementById('early-err')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
    okMsg.classList.toggle('hidden', !ok);
    errMsg.classList.toggle('hidden', ok);
    email.setAttribute('aria-invalid', String(!ok));
    email.classList.toggle('!border-danger', !ok);
    if (ok) okMsg.textContent = 'Thanks. This is a demo form, so nothing was sent.';
    else { errMsg.textContent = 'Enter a valid email address, like you@yourbusiness.com.'; email.focus(); }
  });
</script>
