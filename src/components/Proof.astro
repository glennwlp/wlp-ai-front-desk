---
const items = [
  ['24/7', 'Answers at 2am, on Sundays, and on public holidays.'],
  ['Seconds', 'to reply, instead of the next morning.'],
  ['1 inbox', 'for every conversation, booking, and handoff.'],
];
---
<section class="bg-white">
  <div class="wrap py-14 lg:py-20">
    <ul class="stage grid divide-y divide-stage-deep px-6 sm:px-10 md:grid-cols-3 md:divide-x md:divide-y-0 md:px-0 md:py-8">
      {items.map(([n, t]) => (
        <li class="py-5 text-[18px] leading-[1.45] text-graphite md:px-10 md:py-2">
          <strong class="font-extrabold tracking-[-0.02em] text-ink">{n}</strong> {t}
        </li>
      ))}
    </ul>
  </div>
</section>
