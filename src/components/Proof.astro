---
const items = [
  ['24/7', 'Answers at 2am, on Sundays, and on public holidays.'],
  ['Seconds', 'to reply, instead of the next morning.'],
  ['1 inbox', 'for every conversation, booking, and handoff.'],
];
---
<section class="bg-white">
  <div class="wrap py-14 lg:py-20">
    <ul class="grid gap-3 md:grid-cols-3">
      {items.map(([n, t]) => (
        <li class="flex items-baseline gap-4 rounded-panel border-[1.5px] border-rule px-6 py-5 md:flex-col md:items-start md:gap-2 md:px-7 md:py-6">
          <span class="shrink-0 text-[clamp(30px,3vw,40px)] font-extrabold leading-none tracking-[-0.03em] text-ink">{n}</span>
          <span class="text-[17px] leading-[1.45] text-graphite">{t}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
