---
const items = [
  ['24/7', 'Answers at 2am, on Sundays, and on public holidays.'],
  ['Seconds', 'to reply, instead of the next morning.'],
  ['1 inbox', 'for every conversation, booking, and handoff.'],
];
---
<section class="bg-white">
  <div class="wrap py-12 lg:py-16">
    <div class="grid divide-y divide-rule md:grid-cols-3 md:divide-x md:divide-y-0">
      {items.map(([n, t], i) => (
        <div class:list={['flex flex-col gap-[10px] py-6 md:py-0', i === 0 ? 'md:pr-10' : i === 1 ? 'md:px-10' : 'md:pl-10', i === 0 && 'pt-0 md:pt-0']}>
          <p class="font-display text-[clamp(48px,5vw,64px)] font-bold leading-none tracking-[-1.4px] text-accent">{n}</p>
          <p class="text-[17px] leading-[1.5] text-graphite">{t}</p>
        </div>
      ))}
    </div>
  </div>
</section>
