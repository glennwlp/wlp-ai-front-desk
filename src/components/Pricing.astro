---
import SectionHeader from './SectionHeader.astro';
const plans = [
  {
    name: 'Starter', price: '$XX', desc: 'For owners who want every question answered, day and night.',
    items: ['Website chat widget', 'Trained on your FAQs and documents', 'Handoff to you by email', 'Conversation history'],
    cta: 'Contact us', href: '#contact',
  },
  {
    name: 'Growth', price: '$XX', badge: 'Includes booking', featured: true, desc: 'For businesses that take bookings every day.',
    items: ['Everything in Starter', 'Booking with calendar sync', 'Reminders before every appointment', 'Live handoff to your team', 'Messenger, WhatsApp, Instagram when available'],
    cta: 'Contact us', href: '#contact',
  },
  {
    name: 'Custom', price: 'Coming soon', compact: true, desc: 'For several locations, or agencies setting it up for clients.',
    items: ['Everything in Growth', 'Multiple locations and calendars', 'Your branding on the widget', 'Help with setup'],
    cta: 'Talk to us', href: 'mailto:glenn@whitelabelpress.com',
  },
];
---
<section id="pricing" class="bg-stage">
  <div class="wrap py-16 lg:py-28">
    <SectionHeader title="Pricing">Prices will be confirmed at launch. Early customers keep their launch price.</SectionHeader>
    <div class="mt-12 grid items-stretch gap-4 lg:mt-16 lg:grid-cols-3 lg:gap-5">
      {plans.map((p) => (
        <div class:list={['flex flex-col gap-5 rounded-[28px] px-6 py-8 sm:px-8 lg:py-9', p.featured ? 'on-dark bg-ink text-white shadow-[var(--shadow-lift)]' : 'bg-white']}>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class:list={['text-[24px] font-extrabold leading-[1.2] tracking-[-0.02em]', p.featured ? 'text-white' : 'text-ink']}>{p.name}</h3>
            {p.badge && <span class="rounded-full bg-accent px-3 py-1 text-[13px] font-bold leading-[1.3] text-ink">{p.badge}</span>}
          </div>
          <p class="flex items-baseline gap-2">
            <span class:list={['font-extrabold leading-none tracking-[-0.04em]', p.compact ? 'text-[38px]' : 'text-[56px]', p.featured ? 'text-white' : 'text-ink']}>{p.price}</span>
            {!p.compact && <span class:list={['text-[16px] font-medium', p.featured ? 'text-on-dark-muted' : 'text-graphite']}>per month</span>}
          </p>
          <p class:list={['text-[17px] leading-[1.5]', p.featured ? 'text-on-dark-muted' : 'text-graphite']}>{p.desc}</p>
          <ul class:list={['flex flex-col gap-3 border-t pt-5', p.featured ? 'border-ink-line' : 'border-rule']}>
            {p.items.map((it) => (
              <li class:list={['flex items-start gap-3 text-[16px] leading-[1.45]', p.featured ? 'text-white' : 'text-ink']}>
                <svg class:list={['mt-[3px] shrink-0', p.featured ? 'text-accent' : 'text-accent-ink']} width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 9.5l3.5 3.5 7.5-8"/></svg>{it}
              </li>
            ))}
          </ul>
          <div class="flex-1"></div>
          <a href={p.href} class:list={['btn w-full', p.featured ? 'btn-primary' : 'btn-secondary']}>{p.cta}</a>
        </div>
      ))}
    </div>
  </div>
</section>
