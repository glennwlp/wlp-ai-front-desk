---
interface Props { title: string; class?: string; align?: 'center' | 'start' }
const { title, class: cls = '', align = 'center' } = Astro.props;
---
<div class:list={['flex flex-col gap-5', align === 'center' ? 'items-center text-center' : 'items-start', cls]}>
  <h2 class="h2 max-w-[760px]">{title}</h2>
  <p class="lead max-w-[600px]"><slot /></p>
</div>
