---
import SectionHeader from './SectionHeader.astro';
const points = [
  ['Your branding on the widget', 'Your logo and colours on the chat your clients’ customers see.'],
  ['Multiple locations and calendars', 'Each client, and each of their locations, answers from its own prices and bookings.'],
  ['Help with setup', 'We’ll help you get each client live.'],
];
const brands = [
  ['Harbour Dental', 'bg-accent'],
  ['Northside Barbers', 'bg-ink'],
  ['Olive Studio', 'bg-warning'],
];
---
<section id="agencies" class="bg-accent-wash">
  <div class="wrap flex flex-col gap-10 py-16 md:gap-14 lg:py-[120px]">
    <SectionHeader n="04" title="Sell the night shift under your own name.">Do you build websites or run marketing for local businesses? Offer your clients an AI front desk that carries your brand.</SectionHeader>
    <div class="grid gap-12 lg:grid-cols-[88px_minmax(0,1fr)_minmax(0,400px)] lg:gap-x-10">
      <div class="hidden lg:block"></div>
      <div class="flex flex-col gap-8">
        <dl class="flex flex-col border-t border-ink">
          {points.map(([t, d]) => (
            <div class="grid gap-1 border-b border-border-strong py-5 sm:grid-cols-[240px_minmax(0,1fr)] sm:gap-6">
              <dt class="font-body text-[17px] font-semibold leading-[1.35] tracking-[-0.01em] text-ink">{t}</dt>
              <dd class="text-[16px] leading-[1.6] text-graphite">{d}</dd>
            </div>
          ))}
        </dl>
        <div class="flex flex-col items-start gap-4">
          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <a href="mailto:hello@whitelabelpress.com?subject=AI%20Front%20Desk%20for%20agencies" class="btn btn-dark">Talk to us about agencies</a>
            <a href="#pricing" class="inline-flex min-h-11 items-center text-[16px] font-semibold text-accent-ink underline decoration-accent-ink/40 underline-offset-4 hover:decoration-accent-ink">See the Custom plan</a>
          </div>
          <p class="text-[14px] leading-[1.5] text-graphite">Custom pricing is coming soon. Tell us about your clients and we’ll reply by email.</p>
        </div>
      </div>
      <div class="flex flex-col gap-3 lg:self-start">
        <div class="flex flex-col gap-3" aria-hidden="true">
          {brands.map(([n, bg]) => (
            <div class="overflow-hidden rounded-[10px] border border-border-table bg-white">
              <div class:list={['flex items-center justify-between px-4 py-3 text-white', bg]}>
                <span class="text-[14px] font-semibold leading-[1.3]">{n}</span>
                <span class="text-[12px] font-medium leading-[1.3]">Replies instantly</span>
              </div>
              <div class="flex items-center gap-2 px-4 py-3"><span class="h-2 w-24 rounded-full bg-wash"></span><span class="h-2 w-12 rounded-full bg-wash"></span></div>
            </div>
          ))}
        </div>
        <p class="text-[13px] leading-[1.45] text-graphite">Sample clients, each with their own name and colours.</p>
      </div>
    </div>
  </div>
</section>
