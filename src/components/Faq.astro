---
const faqs = [
  ['Is it only for booking appointments?', 'No. Booking is one part of it. It also answers questions about your services, prices, hours, and policies, sends reminders, and hands conversations to your team when a person is needed.'],
  ['How do I teach it about my business?', 'Upload your FAQs, price list, and documents, or point it at your website. You can see and edit what it knows from the dashboard.'],
  ['What happens when it doesn’t know the answer?', 'It tells the customer it’s checking with the team and passes the conversation to you with the full history.'],
  ['Which channels does it work on?', 'Your website first. Messenger, WhatsApp, and Instagram are planned next.'],
  ['Will it book times I’m not available?', 'No. It reads your connected calendar and your opening hours, and only offers free slots.'],
  ['When can I start?', 'We’re onboarding a small group of businesses first. Send us a message and we’ll reply with setup details.'],
];
---
<section id="faq" class="bg-white">
  <div class="wrap py-16 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,380px)_minmax(0,1fr)] lg:gap-20">
      <div class="flex flex-col gap-5 lg:sticky lg:top-28 lg:self-start">
        <h2 class="h2">Common questions</h2>
        <p class="lead">Something else on your mind? Email <a href="mailto:hello@whitelabelpress.com" class="font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4 hover:decoration-ink">hello@whitelabelpress.com</a> and someone from the team will reply.</p>
      </div>
      <div class="flex flex-col gap-3">
        {faqs.map(([q, a], i) => (
          <details class="faq group rounded-panel bg-stage transition-colors open:bg-white open:shadow-[inset_0_0_0_1.5px_var(--color-rule)]" open={i === 0}>
            <summary class="flex items-center justify-between gap-6 rounded-panel px-6 py-5 sm:px-7">
              <span class="text-[18px] font-bold leading-[1.35] text-ink">{q}</span>
              <span class="faq-icon grid size-9 shrink-0 place-items-center rounded-full bg-white text-ink group-open:bg-accent" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M7 1.5v11M1.5 7h11"/></svg>
              </span>
            </summary>
            <p class="max-w-[640px] px-6 pb-6 text-[17px] leading-[1.6] text-graphite sm:px-7">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
