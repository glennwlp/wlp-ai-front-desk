---
import Clock from './Clock.astro';
---
<section class="on-teal bg-accent">
  <div class="wrap py-12 sm:py-16 lg:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,480px)] lg:gap-20">
      <div class="flex max-w-[620px] flex-col gap-6 lg:gap-8">
        <h1 class="text-[clamp(38px,10.5vw,64px)] font-semibold lg:text-[clamp(44px,5vw,68px)] leading-[1.02] tracking-[-0.025em] text-white">Your AI front desk answers the <span class="whitespace-nowrap">9:58 PM</span> message.</h1>
        <p class="max-w-[480px] text-[18px] leading-[1.6] text-on-accent-muted">AI Front Desk replies to your customers and books their appointments after you’ve closed.</p>
        <div><a href="#early-access" class="btn btn-dark">Get early access</a></div>
      </div>

      <!-- The one unanswered message and the instant reply -->
      <div class="w-full max-w-[480px] rounded-panel bg-white p-6 shadow-[0_24px_48px_rgb(11_31_28/0.28)] sm:p-8 lg:justify-self-end">
        <div>
          <div class="flex items-center gap-4 text-ink" role="group" aria-label="Tuesday night, 9:58 PM">
            <Clock hour={21} minute={58} size={52} />
            <div class="flex flex-col gap-1">
              <p class="time text-[clamp(40px,9vw,60px)] leading-[0.95] tracking-[-0.03em]">9:58 PM</p>
              <p class="dateline text-graphite">Tuesday night</p>
            </div>
          </div>
          <p class="mt-3 text-[15px] leading-[1.45] text-graphite">Northside Barbers closed at 6:00 PM.</p>
          <div class="mt-5 flex flex-col gap-3 border-t border-rule pt-5">
            <div class="flex justify-end"><div class="bubble bubble-customer max-w-[320px] text-[16px]">Do you have anything Saturday morning?</div></div>
            <div class="flex flex-col gap-1">
              <div class="bubble bubble-assistant max-w-[340px] text-[16px]">Hi Priya, yes. Sam has 9:30 or 11:00 on Saturday. Want me to book one?</div>
              <p class="dateline text-graphite">AI Front Desk · 9:58 PM · replied instantly</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
