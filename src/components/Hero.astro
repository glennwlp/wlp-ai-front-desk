---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/img/hero-barber.jpg';
---
<section class="on-teal bg-accent">
  <div class="wrap pt-10 sm:pt-14 min-[1240px]:pt-20">
    <div class="flex flex-col gap-8 min-[1240px]:flex-row min-[1240px]:items-end min-[1240px]:justify-between min-[1240px]:gap-0">
      <div class="flex max-w-[560px] flex-col gap-5 pt-0 min-[1240px]:w-[560px] min-[1240px]:shrink-0 min-[1240px]:gap-7 min-[1240px]:pb-24 min-[1240px]:pt-4">
        <h1 class="text-[clamp(40px,11vw,68px)] font-bold leading-[0.98] tracking-[-1.4px] text-white">Your AI front desk answers, books, and never sleeps.</h1>
        <p class="max-w-[500px] text-[18px] leading-[1.6] text-on-accent-muted">It lives on your website and handles customer conversations from the first question to the booked appointment. Train it on your own FAQs and documents, and step in from a simple dashboard whenever a person is needed.</p>
        <div class="flex flex-wrap gap-3">
          <a href="#early-access" class="btn btn-dark">Get early access</a>
          <a href="#how-it-works" class="btn btn-outline-teal">See how it works</a>
        </div>
        <p class="text-[14px] leading-[1.4] text-on-accent-muted">Website chat at launch. Messenger, WhatsApp and Instagram after that.</p>
      </div>

      <div class="relative mx-auto w-full max-w-[540px] min-[1240px]:mx-0 min-[1240px]:h-[700px] min-[1240px]:w-[620px] min-[1240px]:max-w-none">
        <Image src={heroPhoto} alt="Barber in a navy work shirt smiling at the camera in his shop" widths={[360, 540, 760, 1080]} sizes="(min-width: 1240px) 540px, 100vw" format="webp" quality={78} loading="eager" class="block h-[200px] w-full rounded-2xl sm:max-[1239px]:h-[320px] object-cover min-[1240px]:absolute min-[1240px]:right-0 min-[1240px]:top-0 min-[1240px]:h-[700px] min-[1240px]:w-[540px] min-[1240px]:rounded-b-none" />

        <!-- Booking card: floats over the photo to show the result of the chat -->
        <div class="absolute right-3 top-4 flex w-[260px] items-center gap-[14px] rounded-ui bg-white py-[14px] pl-[14px] pr-4 shadow-[0_16px_32px_rgb(11_18_32/0.2)] sm:right-0 min-[1240px]:left-[380px] min-[1240px]:right-auto min-[1240px]:top-16">
          <div class="flex h-14 w-[52px] shrink-0 flex-col items-center justify-center rounded-control bg-accent-wash text-accent-ink">
            <span class="text-[12px] font-semibold leading-[1.2]">Sat</span>
            <span class="font-display text-[26px] font-bold leading-none">14</span>
          </div>
          <div class="flex min-w-0 flex-col gap-[2px]">
            <span class="text-[12px] font-semibold leading-[1.3] text-accent">New booking</span>
            <span class="text-[15px] font-semibold leading-[1.3] text-ink">Haircut + beard trim</span>
            <span class="text-[13px] leading-[1.4] text-graphite">9:30 with Sam, booked by AI</span>
          </div>
        </div>

        <!-- Chat widget -->
        <div class="relative -mt-24 mb-8 w-[330px] max-w-[calc(100%-16px)] overflow-hidden rounded-[14px] border border-border-table bg-white shadow-[0_24px_48px_rgb(11_31_28/0.28)] min-[1240px]:absolute min-[1240px]:left-0 min-[1240px]:top-[250px] min-[1240px]:mb-0 min-[1240px]:mt-0">
          <div class="flex items-center justify-between border-b border-rule px-4 py-[14px]">
            <span class="text-[14px] font-semibold leading-[1.3] text-ink">Northside Barbers</span>
            <span class="text-[12px] font-medium leading-[1.3] text-accent">Replies instantly</span>
          </div>
          <div class="flex flex-col gap-[10px] p-[14px]">
            <div class="flex justify-end"><div class="bubble bubble-customer text-[13px]">How much is a haircut?</div></div>
            <div class="flex"><div class="bubble bubble-assistant max-w-[248px] text-[13px]">A haircut is $38 and takes about 30 minutes. Want me to find you a time?</div></div>
            <div class="flex justify-end"><div class="bubble bubble-customer text-[13px]">Saturday morning?</div></div>
            <div class="flex"><div class="bubble bubble-assistant max-w-[248px] text-[13px]">Sam has 9:30 or 11:00 this Saturday.</div></div>
            <div class="flex gap-2">
              <span class="rounded-control bg-accent px-[14px] py-[6px] text-[13px] font-semibold leading-[1.3] text-white">9:30</span>
              <span class="rounded-control border border-border-strong bg-white px-[14px] py-[6px] text-[13px] font-semibold leading-[1.3] text-ink">11:00</span>
            </div>
            <p class="rounded-control bg-accent-wash px-3 py-2 text-[12px] font-semibold leading-[1.4] text-accent-ink">Booked with Sam, Saturday 9:30. We’ll remind you on Friday.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
