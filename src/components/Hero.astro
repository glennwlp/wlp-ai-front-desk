---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/img/hero-barber.jpg';
---
<section class="bg-white">
  <div class="wrap pt-10 sm:pt-14 lg:pt-16">
    <div class="mx-auto flex max-w-[1140px] flex-col items-center gap-6 text-center">
      <h1 class="text-[clamp(40px,5.6vw,80px)] font-extrabold leading-[1.02] tracking-[-0.035em] text-ink">Your AI front desk answers, books, and never sleeps.</h1>
      <p class="max-w-[720px] text-[clamp(18px,1.5vw,21px)] leading-[1.55] text-graphite">It lives on your website and handles customer conversations from the first question to the booked appointment. Train it on your own FAQs and documents, and step in from a simple dashboard whenever a person is needed.</p>
      <div class="mt-1 flex flex-wrap justify-center gap-3">
        <a href="#contact" class="btn btn-primary">Contact us</a>
        <a href="#how-it-works" class="btn btn-secondary">See how it works</a>
      </div>
      <p class="text-[15px] leading-[1.4] text-graphite"><span class="mr-2 inline-block size-2 rounded-full bg-accent align-[1px]" aria-hidden="true"></span>Website chat at launch. Messenger, WhatsApp and Instagram after that.</p>
    </div>

    <!-- Stage: photo, sample chat and booking card -->
    <div class="stage relative mt-10 flex flex-col overflow-hidden px-4 pb-0 pt-6 sm:px-8 lg:mt-14 lg:block lg:h-[580px] lg:p-0">
      <Image src={heroPhoto} alt="Barber in a navy work shirt smiling at the camera in his shop" widths={[360, 540, 760, 1080]} sizes="(min-width: 1024px) 440px, 100vw" format="webp" quality={78} loading="eager" class="relative order-1 mx-auto block h-[280px] w-full max-w-[460px] rounded-[24px] object-cover sm:h-[360px] lg:absolute lg:bottom-0 lg:left-1/2 lg:h-[520px] lg:w-[440px] lg:max-w-none lg:-translate-x-1/2 lg:rounded-b-none lg:rounded-t-[28px]" />

      <!-- Booking card -->
      <div id="demo-booking" class="demo-reveal demo-card relative z-10 order-3 mx-auto mb-6 flex w-full max-w-[300px] items-center gap-[14px] rounded-[20px] bg-white py-[14px] pl-[14px] pr-4 shadow-[var(--shadow-lift)] lg:absolute lg:left-[calc(50%+130px)] lg:top-[160px] lg:order-none lg:mx-0 lg:mb-0 lg:w-[290px]" aria-hidden="true">
        <div class="demo-date flex h-14 w-[52px] shrink-0 flex-col items-center justify-center rounded-[14px] transition-colors">
          <span class="text-[12px] font-bold leading-[1.2]">Sat</span>
          <span class="text-[24px] font-extrabold leading-none">14</span>
        </div>
        <div class="flex min-w-0 flex-col gap-[2px]">
          <span class="text-[12px] font-bold leading-[1.3] text-accent-ink">New booking</span>
          <span class="text-[15px] font-bold leading-[1.3] text-ink">Haircut + beard trim</span>
          <span class="demo-yes text-[13px] leading-[1.4] text-graphite"><span data-demo-time>9:30</span> with Sam, booked by AI</span>
          <span class="demo-no text-[13px] font-semibold leading-[1.4] text-accent-ink">Pick a time in the chat</span>
        </div>
      </div>

      <!-- Sample chat -->
      <div id="demo-chat" data-booked="true" class="relative z-10 order-2 mx-auto -mt-14 mb-4 w-full max-w-[360px] overflow-hidden rounded-[24px] bg-white shadow-[var(--shadow-lift)] sm:-mt-20 lg:absolute lg:left-[6%] lg:top-14 lg:mx-0 lg:mt-0 lg:w-[360px]">
        <div class="flex items-center gap-3 border-b border-rule px-5 py-4">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-ink text-[14px] font-extrabold text-white" aria-hidden="true">N</span>
          <div class="flex min-w-0 flex-col">
            <span class="whitespace-nowrap text-[15px] font-bold leading-[1.3] text-ink">Northside Barbers</span>
            <span class="flex items-center gap-[6px] whitespace-nowrap text-[13px] font-semibold leading-[1.3] text-accent-ink"><span class="size-[7px] rounded-full bg-accent" aria-hidden="true"></span>Replies instantly</span>
          </div>
        </div>
        <div class="flex flex-col gap-[10px] bg-stage/60 p-4">
          <div class="demo-msg flex justify-end"><div class="bubble bubble-customer text-[14px]">How much is a haircut?</div></div>
          <div class="demo-msg relative flex"><span class="demo-typing bubble bubble-assistant" aria-hidden="true"><i></i><i></i><i></i></span><div class="bubble bubble-assistant max-w-[260px] text-[14px]">A haircut is $38 and takes about 30 minutes. Want me to find you a time?</div></div>
          <div class="demo-msg flex justify-end"><div class="bubble bubble-customer text-[14px]">Saturday morning?</div></div>
          <div class="demo-msg relative flex"><span class="demo-typing bubble bubble-assistant" aria-hidden="true"><i></i><i></i><i></i></span><div class="bubble bubble-assistant max-w-[260px] text-[14px]">Sam has 9:30 or 11:00 this Saturday.</div></div>
          <div class="demo-msg flex gap-2" role="group" aria-label="Pick a time">
            {['9:30', '11:00'].map((t, i) => (
              <button type="button" data-slot={t} aria-pressed={i === 0 ? 'true' : 'false'} class="demo-slot min-h-10 cursor-pointer rounded-full border-[1.5px] border-ink bg-white px-4 py-[6px] text-[14px] font-bold leading-[1.3] text-ink hover:bg-accent-wash aria-pressed:border-accent aria-pressed:bg-accent disabled:cursor-default">{t}</button>
            ))}
          </div>
          <p id="demo-confirm" class="demo-reveal demo-after rounded-[14px] bg-accent-wash px-3 py-2 text-[13px] font-semibold leading-[1.4] text-accent-ink">Booked with Sam, Saturday <span data-demo-time>9:30</span>. We’ll remind you on Friday.</p>
          <p class="flex items-center justify-between gap-2 text-[12px] leading-[1.4] text-faint">
            <span id="demo-hint">Sample chat</span>
            <button id="demo-reset" type="button" class="hidden cursor-pointer font-semibold text-graphite underline decoration-1 underline-offset-[3px] hover:text-ink">Replay</button>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  // Sample chat. Without JS it shows the booked state. With motion allowed, the conversation plays on a
  // loop (paused on hover, offscreen or in a hidden tab) until the visitor picks a time themselves.
  const chat = document.getElementById('demo-chat')!;
  const card = document.getElementById('demo-booking')!;
  const confirm = document.getElementById('demo-confirm')!;
  const rows = [...chat.querySelectorAll<HTMLElement>('.demo-msg')];
  const slots = [...chat.querySelectorAll<HTMLButtonElement>('[data-slot]')];
  const hint = document.getElementById('demo-hint')!;
  const reset = document.getElementById('demo-reset')!;
  const setState = (time: string | null) => {
    const booked = time !== null;
    chat.dataset.booked = String(booked);
    card.dataset.booked = String(booked);
    slots.forEach((b) => { b.setAttribute('aria-pressed', String(b.dataset.slot === time)); b.disabled = booked; });
    if (time) document.querySelectorAll('[data-demo-time]').forEach((el) => (el.textContent = time));
    hint.textContent = booked ? 'Sample chat' : 'Sample chat: tap a time to book it';
    reset.classList.toggle('hidden', !booked);
  };

  const show = (n: number) => () => { rows[n].classList.remove('is-typing'); rows[n].classList.add('is-in'); };
  const typing = (n: number) => () => rows[n].classList.add('is-typing');
  const steps: [number, () => void][] = [
    [600, show(0)],
    [700, typing(1)],
    [1300, show(1)],
    [1400, show(2)],
    [700, typing(3)],
    [1000, show(3)],
    [400, show(4)],
    [1500, () => slots[0].classList.add('is-tap')],
    [160, () => { slots[0].classList.remove('is-tap'); setState('9:30'); }],
    [4200, () => { chat.dataset.leaving = ''; rows.forEach((r) => r.classList.remove('is-in')); setState(null); }],
    [400, () => delete chat.dataset.leaving],
  ];
  let step = 0, timer = 0, due = 0, left = -1, stopped = false;
  const holds = new Set<string>();
  const tick = () => {
    if (stopped || holds.size || timer) return;
    if (left < 0) left = steps[step][0];
    due = Date.now() + left;
    timer = window.setTimeout(() => {
      timer = 0; left = -1;
      steps[step][1]();
      step = (step + 1) % steps.length;
      tick();
    }, left);
  };
  const hold = (why: string, on: boolean) => {
    if (on) { holds.add(why); if (timer) { clearTimeout(timer); timer = 0; left = Math.max(0, due - Date.now()); } }
    else { holds.delete(why); tick(); }
  };
  const play = () => {
    stopped = false; step = 0; left = -1;
    rows.forEach((r) => r.classList.remove('is-in', 'is-typing'));
    setState(null);
    chat.dataset.playing = '';
    tick();
  };
  const stop = () => {
    stopped = true; clearTimeout(timer); timer = 0;
    delete chat.dataset.playing; delete chat.dataset.leaving;
    rows.forEach((r) => r.classList.remove('is-typing'));
  };

  const animate = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  slots.forEach((b) => b.addEventListener('click', () => {
    stop();
    confirm.setAttribute('aria-live', 'polite');
    setState(b.dataset.slot!);
  }));
  reset.addEventListener('click', () => {
    if (animate) play();
    else { setState(null); slots[0].focus(); }
  });
  if (animate) {
    chat.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && hold('hover', true));
    chat.addEventListener('pointerleave', () => hold('hover', false));
    new IntersectionObserver(([e]) => hold('offscreen', !e.isIntersecting)).observe(chat);
    document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));
    play();
  } else setState(null);
</script>
