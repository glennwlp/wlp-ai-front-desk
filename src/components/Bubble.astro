---
interface Props { role: 'customer' | 'assistant'; dark?: boolean; class?: string }
const { role, dark = false, class: cls = '' } = Astro.props;
---
<div class:list={['flex', role === 'customer' ? 'justify-end' : 'justify-start']}>
  <div class:list={['bubble max-w-[440px] text-[16px]', role === 'customer' ? (dark ? 'bubble-customer-dark' : 'bubble-customer') : 'bubble-assistant', cls]}><slot /></div>
</div>
