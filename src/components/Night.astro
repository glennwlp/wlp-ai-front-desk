---
import Bubble from './Bubble.astro';
import SectionHeader from './SectionHeader.astro';
const files = ['price-list.pdf', 'faq.docx', 'cancellation-policy.pdf', 'opening-hours.txt'];
const inbox = [
  ['Jordan P.', 'Can I bring my own beard oil?', 'Needs Sam', 'bg-warning-wash text-warning'],
  ['Priya K.', 'Haircut + beard, Sat 9:30', 'Booked', 'bg-accent-wash text-accent-ink'],
  ['Tom W.', 'Do you take card?', 'Answered', 'bg-wash text-graphite'],
];
const entry = 'tl-entry relative flex flex-col gap-5 pb-14 pl-9 lg:grid lg:grid-cols-[220px_minmax(0,1fr)_300px] lg:gap-x-10 lg:gap-y-0 lg:pb-20 lg:pl-0';
const noteDark = 'tl-item flex max-w-[420px] flex-col gap-2 border-t border-border-dark pt-4 lg:self-start';
const noteLight = 'tl-item flex max-w-[420px] flex-col gap-2 border-t border-ink pt-4 lg:self-start';
const noteH = 'font-body text-[17px] font-semibold leading-[1.3] tracking-[-0.01em]';
---
<!-- Timeline: 9:58 PM to 7:05 AM. Night band first, then the morning band. -->
<section id="night" class="on-dark bg-ink">
  <div class="wrap pt-16 lg:pt-[120px]">
    <SectionHeader n="01" dark title="Nine hours. Nobody awake. Nothing missed.">One night at a barbershop, from the first message to the owner’s first look at the phone.</SectionHeader>

    <div class="mt-12 lg:mt-20" style="--rail: var(--color-border-dark); --halo: var(--color-ink);">
      <!-- 9:58 PM -->
      <article class={entry}>
        <div class="tl-item flex flex-col gap-1 lg:pt-0">
          <time datetime="21:58" class="time text-[34px] leading-none text-white lg:text-[40px]">9:58 PM</time>
          <p class="dateline text-on-dark-muted">Tuesday night</p>
        </div>
        <div class="tl-item flex max-w-[560px] flex-col gap-4">
          <h3 class="font-display text-[28px] font-semibold leading-[1.12] tracking-[-0.02em] text-white lg:text-[32px]">The message nobody is awake to read.</h3>
          <p class="max-w-[520px] text-[17px] leading-[1.65] text-on-dark-muted">Priya asks whether there’s anything free on Saturday morning. The shop closed at 6:00 PM and the phone is face down. AI Front Desk replies in the same minute, so she isn’t left waiting.</p>
        </div>
        <aside class={noteDark}>
          <h4 class={noteH + ' text-white'}>Without it</h4>
          <p class="text-[15px] leading-[1.6] text-on-dark-muted">The message sits unread until 7:05 AM. By then: “Never mind, I’ve booked somewhere else.”</p>
        </aside>
        <span class="tl-rail" aria-hidden="true"></span><span class="tl-dot" aria-hidden="true"></span>
      </article>

      <!-- 10:02 PM -->
      <article class={entry}>
        <div class="tl-item flex flex-col gap-1">
          <time datetime="22:02" class="time text-[34px] leading-none text-white lg:text-[40px]">10:02 PM</time>
          <p class="dateline text-on-dark-muted">Tuesday night</p>
        </div>
        <div class="tl-item flex max-w-[560px] flex-col gap-5">
          <h3 class="font-display text-[28px] font-semibold leading-[1.12] tracking-[-0.02em] text-white lg:text-[32px]">It answers, and quotes a price.</h3>
          <div class="flex flex-col gap-[10px]">
            <Bubble role="customer" dark>Haircut and beard trim. How much?</Bubble>
            <Bubble role="assistant">A haircut is $38 and a beard trim is $22. Booked together, it’s $55. Want Saturday at 9:30?</Bubble>
          </div>
          <ul class="flex flex-wrap items-center gap-2" aria-label="Answered from these documents">
            {files.map((f, i) => (
              <li class:list={['flex items-center gap-2 rounded-chip border border-border-dark px-[10px] py-[5px] text-[13px] font-medium leading-[1.3]', i === 0 ? 'text-white' : 'text-on-dark-muted']}>
                <span class:list={['size-[7px] rounded-full', i === 0 ? 'bg-accent-bright' : 'bg-on-dark-faint']} aria-hidden="true"></span>{f}
              </li>
            ))}
          </ul>
        </div>
        <aside class={noteDark}>
          <h4 class={noteH + ' text-white'}>Trained on your business</h4>
          <p class="text-[15px] leading-[1.6] text-on-dark-muted">It answers from the price list, FAQs and policies you give it, and nothing else.</p>
        </aside>
        <span class="tl-rail" aria-hidden="true"></span><span class="tl-dot" aria-hidden="true"></span>
      </article>

      <!-- 11:40 PM -->
      <article class={entry}>
        <div class="tl-item flex flex-col gap-1">
          <time datetime="23:40" class="time text-[34px] leading-none text-white lg:text-[40px]">11:40 PM</time>
          <p class="dateline text-on-dark-muted">Tuesday night</p>
        </div>
        <div class="tl-item flex max-w-[560px] flex-col gap-5">
          <h3 class="font-display text-[28px] font-semibold leading-[1.12] tracking-[-0.02em] text-white lg:text-[32px]">The booking is confirmed.</h3>
          <div class="flex flex-col gap-[10px]">
            <Bubble role="customer" dark>9:30 please.</Bubble>
            <Bubble role="assistant">Done. Haircut and beard trim with Sam, Saturday at 9:30. I’ll remind you on Friday evening.</Bubble>
          </div>
          <div class="flex w-full max-w-[340px] items-center gap-[14px] rounded-ui bg-white py-3 pl-3 pr-4">
            <div class="flex h-14 w-[52px] shrink-0 flex-col items-center justify-center rounded-control bg-accent-wash text-accent-ink">
              <span class="text-[12px] font-semibold leading-[1.2]">Sat</span>
              <span class="time text-[26px] leading-none">14</span>
            </div>
            <div class="flex min-w-0 flex-col gap-[2px]">
              <span class="text-[12px] font-semibold leading-[1.3] text-accent-ink">New booking</span>
              <span class="text-[15px] font-semibold leading-[1.3] text-ink">Haircut + beard trim</span>
              <span class="text-[13px] leading-[1.4] text-graphite">9:30 with Sam, booked by AI</span>
            </div>
          </div>
        </div>
        <aside class={noteDark}>
          <h4 class={noteH + ' text-white'}>Books and reminds</h4>
          <p class="text-[15px] leading-[1.6] text-on-dark-muted">It checks your calendar and only offers times that are free. A reminder goes out the day before.</p>
        </aside>
        <span class="tl-rail" aria-hidden="true"></span><span class="tl-dot" aria-hidden="true"></span>
      </article>

      <!-- 2:15 AM -->
      <article class={entry}>
        <div class="tl-item flex flex-col gap-1">
          <time datetime="02:15" class="time text-[34px] leading-none text-white lg:text-[40px]">2:15 AM</time>
          <p class="dateline text-on-dark-muted">Wednesday</p>
        </div>
        <div class="tl-item flex max-w-[560px] flex-col gap-5">
          <h3 class="font-display text-[28px] font-semibold leading-[1.12] tracking-[-0.02em] text-white lg:text-[32px]">A question it can’t answer is flagged for you.</h3>
          <div class="flex flex-col gap-[10px]">
            <Bubble role="customer" dark>Can I bring my own beard oil? I’m allergic to some.</Bubble>
            <Bubble role="assistant">That’s one for Sam. I’ve flagged this chat for him with the whole conversation, and he’ll reply in the morning.</Bubble>
          </div>
          <p class="flex w-fit items-center gap-2 rounded-chip bg-warning-wash px-3 py-[6px] text-[13px] font-semibold leading-[1.3] text-warning"><span class="size-2 rounded-full bg-warning" aria-hidden="true"></span>Flagged for Sam, waiting for a person</p>
        </div>
        <aside class={noteDark}>
          <h4 class={noteH + ' text-white'}>Hands off to a human</h4>
          <p class="text-[15px] leading-[1.6] text-on-dark-muted">When a question needs a person, it says so and passes the conversation to your team rather than guessing.</p>
        </aside>
        <span class="tl-rail" aria-hidden="true"></span><span class="tl-dot" aria-hidden="true"></span>
      </article>
    </div>
  </div>
</section>

<!-- Morning band: same grid, same rail, daylight -->
<section class="bg-wash">
  <div class="wrap pb-16 lg:pb-[120px]" style="--rail: var(--color-border-strong); --fill: var(--color-accent); --dot: var(--color-accent); --halo: var(--color-wash);">
    <article class={entry.replace('lg:pb-20', 'lg:pb-0').replace('pb-14', 'pb-0')}>
      <div class="tl-item flex flex-col gap-1 pt-14">
        <time datetime="07:05" class="time text-[34px] leading-none text-ink lg:text-[40px]">7:05 AM</time>
        <p class="dateline text-graphite">Wednesday morning</p>
      </div>
      <div class="tl-item flex max-w-[600px] flex-col gap-5 lg:pt-14">
        <h3 class="font-display text-[28px] font-semibold leading-[1.12] tracking-[-0.02em] text-ink lg:text-[32px]">You wake to one inbox.</h3>
        <div class="overflow-hidden rounded-[10px] border border-border-table bg-white" role="table" aria-label="Sample overnight inbox">
          <div role="row" class="flex items-center justify-between gap-4 border-b border-rule px-4 py-3">
            <span role="cell" class="text-[14px] font-semibold leading-[1.3] text-ink">Overnight at Northside Barbers</span>
            <span role="cell" class="dateline shrink-0 text-graphite">Sample</span>
          </div>
          {inbox.map(([name, msg, status, tone], i) => (
            <div role="row" class:list={['flex items-center gap-4 px-4 py-[14px]', i > 0 && 'border-t border-rule']}>
              <span role="cell" class="w-[84px] shrink-0 text-[14px] font-semibold leading-[1.3] text-ink">{name}</span>
              <span role="cell" class="min-w-0 flex-1 text-[14px] leading-[1.3] text-graphite max-sm:basis-0">{msg}</span>
              <span role="cell" class={`shrink-0 rounded-chip px-2 py-[3px] text-[12px] font-semibold leading-[1.3] ${tone}`}>{status}</span>
            </div>
          ))}
        </div>
        <p class="max-w-[520px] border border-dashed border-border-strong px-4 py-3 text-[14px] leading-[1.55] text-graphite"><span class="font-semibold text-ink">Placeholder.</span> Real early-access numbers, such as messages answered overnight, bookings made and time to first reply, will go here once the first ten shops are live.</p>
      </div>
      <aside class={noteLight + ' lg:mt-14'}>
        <h4 class={noteH + ' text-ink'}>Simple dashboard, starting on your website</h4>
        <p class="text-[15px] leading-[1.6] text-graphite">Every conversation, booking and handoff lands in one inbox. The widget starts on your website, with Messenger, WhatsApp and Instagram after that.</p>
      </aside>
      <span class="tl-rail !top-0" aria-hidden="true" style="bottom: auto; height: 56px;"></span>
      <span class="tl-dot !top-[64px]" aria-hidden="true"></span>
    </article>
  </div>
</section>
<script>
  // Reveal each moment of the night as it scrolls into view. Without JS or with reduced motion, everything is simply visible.
  const entries = document.querySelectorAll<HTMLElement>('.tl-entry');
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((list) => {
      list.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -18% 0px', threshold: 0.05 });
    entries.forEach((el) => io.observe(el));
  } else {
    entries.forEach((el) => el.classList.add('in'));
  }
</script>
