---
import SectionHeader from './SectionHeader.astro';
const steps = [
  ['1', 'Add what you know', 'Upload your FAQs, price list, and policies, or point it at your current website.'],
  ['2', 'Connect your calendar', 'Add your services, durations, and opening hours so it only offers times that are actually free.'],
  ['3', 'Paste the widget', 'Add one snippet to WordPress, Shopify, Wix, or any site. Set the colours to match your brand.'],
  ['4', 'Check in when you like', 'Read conversations, see bookings, and pick up handoffs from the dashboard.'],
];
---
<section id="how-it-works" class="bg-white">
  <div class="wrap py-16 lg:py-28">
    <SectionHeader title="Set up in an afternoon">No code to write. If you can fill in a form and paste one line into your website, you can launch it.</SectionHeader>
    <ol class="relative mt-12 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-6">
      <span class="absolute left-[28px] right-[28px] top-[28px] hidden h-[2px] bg-rule lg:block" aria-hidden="true"></span>
      {steps.map(([n, t, d], i) => (
        <li class="relative flex flex-col gap-3">
          <span class:list={['grid size-14 place-items-center rounded-full text-[22px] font-extrabold leading-none ring-8 ring-white', i === 3 ? 'bg-accent text-ink' : 'bg-ink text-white']}>{n}</span>
          <h3 class="mt-3 text-[22px] font-extrabold leading-[1.2] tracking-[-0.02em] text-ink">{t}</h3>
          <p class="max-w-[300px] text-[17px] leading-[1.55] text-graphite">{d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
