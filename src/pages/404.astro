---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Page not found | AI Front Desk by WhitelabelPRESS" description="Page not found.">
  <Nav />
  <main id="main" class="bg-white">
    <div class="wrap flex min-h-[60vh] flex-col items-center text-center justify-center gap-5 py-24">
      <p class="text-[clamp(72px,20vw,96px)] font-extrabold leading-[0.9] tracking-[-0.04em] text-ink">404</p>
      <h1 class="h2">That page isn’t here.</h1>
      <p class="lead max-w-[460px]">The link may be old, or the page may have moved. The front desk is still open.</p>
      <a href="/" class="btn btn-primary mt-2">Back to home</a>
    </div>
  </main>
  <Footer />
</Base>
